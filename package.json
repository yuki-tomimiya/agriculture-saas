{
  "name": "agriculture-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "soil:import": "tsx scripts/soil-import.ts",
    "soil:verify": "tsx scripts/soil-verify.ts",
    "soil:test": "tsx --test tests/soil-map.test.ts",
    "soil:refresh": "tsx scripts/soil-refresh.ts",
    "soil:farm-test": "tsx --test tests/farm-soil.test.ts",
    "soil:nutrient-test": "tsx --test tests/soil-nutrients.test.tsx",
    "soil:ui-test": "tsx --test tests/soil-ui.test.tsx",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "check-data": "tsx scripts/proposal-check-data.ts",
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/check-build-port.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "jma:stations": "npx tsx scripts/fetch-jma-stations.ts",
    "jma:observations": "npx tsx scripts/fetch-jma-observations.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.6.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "fflate": "0.8.2",
    "postcss": "^8.4.0",
    "prisma": "^5.19.0",
    "shapefile": "0.6.6",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.15",
    "typescript": "^5.5.0"
  }
}
