// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  farms              Farm[]
  crops              Crop[]   // 農場に紐づけない作物（作物だけで登録した分）
  pesticideRecords   PesticideRecord[]
  fertilizerRecords  FertilizerRecord[]
  sales              Sale[]
  proposalDismissals ProposalDismissal[]
  soilDiagnoses      SoilDiagnosis[]
}

model Farm {
  id          String       @id @default(cuid())
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  fields      Field[]
  crops       Crop[]
  tasks             Task[]
  workRecords       WorkRecord[]
  pesticideRecords  PesticideRecord[]
  fertilizerRecords FertilizerRecord[]
  sales             Sale[]
  soilDiagnoses     SoilDiagnosis[]
}

model Field {
  id          String   @id @default(cuid())
  name        String
  area        Float?   // 面積（平方メートル）
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  crops       Crop[]
  soilDiagnoses SoilDiagnosis[]
}

model Crop {
  id              String       @id @default(cuid())
  name            String
  variety         String?      // 品種
  plantingDate    DateTime?
  harvestDate     DateTime?
  status          String       @default("growing") // growing, harvested, completed
  baseTemperature Float?       @default(10.0) // GDD計算用の基準温度
  userId          String?      // 農場に紐づけない場合の所有者
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId          String?      // 任意：農場に紐づける場合
  farm            Farm?        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldId         String?
  field           Field?       @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  harvests          Harvest[]
  tasks             Task[]
  workRecords       WorkRecord[]
  pesticideRecords  PesticideRecord[]
  fertilizerRecords FertilizerRecord[]
  sales             Sale[]
  proposalDismissals ProposalDismissal[]
}

model Harvest {
  id          String   @id @default(cuid())
  date        DateTime
  quantity    Float    // 収穫量
  unit        String   @default("kg") // kg, 個, etc.
  notes       String?
  cropId      String
  crop        Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      String       @default("pending") // pending, in_progress, completed
  priority    String       @default("medium") // low, medium, high
  dueDate     DateTime?
  farmId      String
  farm        Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?        @relation(fields: [cropId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workRecords WorkRecord[]
}

model WorkRecord {
  id          String   @id @default(cuid())
  date        DateTime
  taskType   String   // 作業種別（植え付け、追肥、防除など）
  description String?
  notes       String?
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PesticideRecord {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedAt         DateTime // 散布日
  productName       String   // 農薬名
  amount            Float?   // 使用量
  amountUnit        String?  // 単位（L, g, mL など）
  dilution          String?  // 希釈倍率（例: 1000倍）
  applicationCount  Int?     // 使用回数（この作付けで何回目か）
  daysBeforeHarvest Int?    // 収穫前日数
  cropId            String?
  crop              Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  farmId            String?
  farm              Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FertilizerRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appliedAt      DateTime // 施肥日
  productName    String   // 肥料名
  amount         Float    // 使用量
  amountUnit     String   @default("kg") // kg, g, L など
  componentInfo  String?  // 成分（N-P-K など）
  cropId         String?
  crop           Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  farmId         String?
  farm           Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WeatherData {
  id          String   @id @default(cuid())
  date        DateTime
  latitude    Float
  longitude   Float
  temperature Float?   // 平均気温
  maxTemp     Float?   // 最高気温
  minTemp     Float?   // 最低気温
  precipitation Float? // 降水量
  windSpeed   Float?   // 風速
  humidity    Float?   // 湿度
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, latitude, longitude])
  @@index([date])
  @@index([latitude, longitude])
}

model Sale {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  cropId       String?
  crop         Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)
  farmId       String?
  farm         Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  quantity     Float
  unit         String   @default("kg")
  unitPrice    Int      // 単価（円）
  amount       Int      // 売上金額（円）
  customerName String   // 販売先
  channel      String?  // 販売チャネル（直売所、市場、JA など）
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SoilDiagnosis {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldId     String?
  field       Field?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  diagnosedAt DateTime
  ph          Float?
  ec          Float?
  nitrogen    Float? // 硝酸態窒素 mg/100g
  phosphorus  Float? // 有効態リン酸 mg/100g
  potassium   Float? // 交換性カリ mg/100g
  notes       String?
  photoPath   String? // data/soil-photos 内のファイル名だけ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, diagnosedAt])
}

model ProposalDismissal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropId      String?
  crop        Crop?    @relation(fields: [cropId], references: [id], onDelete: Cascade)
  trigger     String
  dismissedAt DateTime @default(now())
  remindAfter DateTime
  @@index([userId, remindAfter])
}
